rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /user_avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Evidence Vault — photos / videos / voice notes.
    match /evidences/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Chat image attachments.
    match /chat_files/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
